  "sections": [
    {
      "id": "tape_distance",
      "title": "1. Distance between Tape and Charger",
      "type": "measurement",
      "items": [
        {
          "id": "distance_h",
          "label": "Current Distance (H) with magnetic tape (mm) [Allowable: 330 mm - 340 mm]",
          "type": "text"
        }
      ]
    },
    {
      "id": "copper_plate",
      "title": "2. Copper Plate Tension and Surface",
