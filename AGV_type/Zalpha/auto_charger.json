      "ratingOptions": [
        "1 - Check OK",
        "2 - Require Future Attention",
        "3 - Require Immediate Attention"
      ],
      "items": [
        {
          "id": "spring_tension",
          "label": "Spring able to contract and retract smoothly"
        },
        {
          "id": "plate_scratch",
          "label": "Copper Plate Scratch / Broken"
        },
        {
          "id": "plate_stained",
          "label": "Copper Plate Stained"
        },
        {
          "id": "plate_oxidize",
          "label": "Copper Plate Oxidize (Decolorize)"
        }
      ]
    },
    {
      "id": "roller_surface",
      "title": "3. Roller Surface Conditions (Tick X if Wear Off)",
      "type": "rating_matrix",
      "ratingOptions": [
        "1 - Check OK",
        "2 - Require Future Attention",
        "3 - Require Immediate Attention"
      ],
      "items": [
        {
          "id": "roller_front",
          "label": "Roller Front Position"
        },
        {
          "id": "roller_rear",
          "label": "Roller Rear Position"
        },
        {
          "id": "roller_center",
          "label": "Roller Centre Position (Fast Charger)"
        }
      ]
    },
    {
      "id": "voltage_readings",
      "title": "4. LCD Screen & Voltage Readings (Allowable: > 27.8 V \u00b1 0.3 V)",
      "type": "voltage_readings",
      "items": [
        {
          "id": "lcd_scratch",
          "label": "LCD Screen Scratch",
          "type": "toggle"
        },
        {
          "id": "lcd_flicker",
          "label": "LCD Screen Flickering",
          "type": "toggle"
        },
        {
          "id": "lcdReading",
          "label": "LCD Voltage Reading (V)",
          "type": "text"
        },
        {
          "id": "plateReading",
          "label": "Plate Voltage Reading (V)",
          "type": "text"
        },
        {
          "id": "manualReading",
          "label": "Manual Charger Voltage Reading (V)",
          "type": "text"
        },
        {
          "id": "derlin_condition",
          "label": "Derlin Condition",
          "type": "select",
          "options": [
            "1 - Check OK",
            "2 - Require Future Attention",
            "3 - Require Immediate Attention"
          ]
        }
      ]
